# Secrets - never commit these
server/credentials.json
server/token.json
server/.sim_state.json
*.env

# Your real calendar ids and timezone. Start from config.example.yaml.
server/config.yaml

# Runtime state
server/*.db
server/*.db-wal
server/*.db-shm

# Python
server/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Connect IQ build output
garmin/bin/
garmin/gen/
garmin/internal-mir/
garmin/external-mir/
# Regenerated by the SDK from settings.xml + properties.xml, and therefore
# carries a copy of whatever authToken is in properties.xml.
garmin/garmin-settings.json
*.prg
*.prg.debug.xml
developer_key*

.DS_Store
